+  it('runs the guard seat before every route, fallback, and upgrade', { timeout: 60_000 }, async () => {
+    const loaded = await loadComposition()
+    const server = loaded.webServer
+    const port = server.port
+    server.register({ kind: 'exact', path: '/probe', handler: (_req, res) => { res.writeHead(200); res.end('EXACT') } })
+    server.registerFallback((_req, res) => { res.writeHead(200); res.end('FALLBACK') })
+    server.registerUpgrade({
+      path: '/events',
+      handler: (_req, socket) => {
+        socket.write('HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: dsh-test\r\n\r\n')
+      },
+    })
+
+    // One owner only; the disposer releases the seat.
+    const releaseGuard = server.registerGuard({
+      request: (req, res) => {
+        if (req.headers['x-admit'] === 'yes') return true
+        res.writeHead(403)
+        res.end('REFUSED')
+        return false
+      },
+      upgrade: (req, socket) => {
+        if (req.headers['x-admit'] === 'yes') return true
+        socket.end('HTTP/1.1 401 Unauthorized\r\n\r\n')
+        return false
+      },
+    })
+    expect(() => server.registerGuard({ request: () => true, upgrade: () => true }))
+      .toThrow(/guard already registered/)
+
+    // Refusal answers before any route or the fallback dispatches; admission
+    // dispatches normally on both named routes and the fallback seat.
+    expect(await request(port, '/probe')).toMatchObject({ status: 403, body: 'REFUSED' })
+    expect(await request(port, '/no/such/route')).toMatchObject({ status: 403, body: 'REFUSED' })
+    expect(await request(port, '/probe', { headers: { 'x-admit': 'yes' } })).toMatchObject({ status: 200, body: 'EXACT' })
+    expect(await request(port, '/no/such/route', { headers: { 'x-admit': 'yes' } })).toMatchObject({ status: 200, body: 'FALLBACK' })
+
+    // A refused upgrade never reaches the handler; the guard owns the socket.
+    const refused = connect(port, '127.0.0.1')
+    await once(refused, 'connect')
+    const refusedData = once(refused, 'data')
+    refused.write([
+      'GET /events HTTP/1.1',
+      `Host: 127.0.0.1:${String(port)}`,
+      'Connection: Upgrade',
+      'Upgrade: dsh-test',
+      '',
+      '',
+    ].join('\r\n'))
+    const [refusedResponse] = await refusedData as [Buffer]
+    expect(String(refusedResponse)).toContain('401 Unauthorized')
+
+    // An admitted upgrade dispatches to its route.
+    const admitted = connect(port, '127.0.0.1')
+    await once(admitted, 'connect')
+    const admittedData = once(admitted, 'data')
+    admitted.write([
+      'GET /events HTTP/1.1',
+      `Host: 127.0.0.1:${String(port)}`,
+      'Connection: Upgrade',
+      'Upgrade: dsh-test',
+      'x-admit: yes',
+      '',
+      '',
+    ].join('\r\n'))
+    const [admittedResponse] = await admittedData as [Buffer]
+    expect(String(admittedResponse)).toContain('101 Switching Protocols')
+    admitted.destroy()
+
+    // A guard failure is contained per request (400) and the server keeps serving.
+    releaseGuard()
+    const releaseThrowingGuard = server.registerGuard({
+      request: () => { throw new Error('guard failure') },
+      upgrade: () => { throw new Error('guard failure') },
+    })
+    expect((await request(port, '/probe')).status).toBe(400)
+    const brokenUpgrade = connect(port, '127.0.0.1')
+    brokenUpgrade.on('error', () => { /* The server-side reset is the fixture outcome. */ })
+    await once(brokenUpgrade, 'connect')
+    const brokenUpgradeClosed = once(brokenUpgrade, 'close')
+    brokenUpgrade.write([
+      'GET /events HTTP/1.1',
+      `Host: 127.0.0.1:${String(port)}`,
+      'Connection: Upgrade',
+      'Upgrade: dsh-test',
+      '',
+      '',
+    ].join('\r\n'))
+    await brokenUpgradeClosed
+
+    // Releasing the seat restores unguarded dispatch and registrability.
+    releaseThrowingGuard()
+    expect(await request(port, '/probe')).toMatchObject({ status: 200, body: 'EXACT' })
+    expect(() => server.registerGuard({ request: () => true, upgrade: () => true })).not.toThrow()
+  })
