{
  "name": "@night-stars-1/dsh-mcp-config",
  "description": "Third-party dsh MCP server manager: a settings page to add/remove MCP servers, persisted in a storage domain and hot-applied as live dsh-mcp-client instances",
  "version": "0.1.0",
  "author": "Night-stars-1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Night-stars-1/dsh-plugins.git",
    "directory": "dsh-mcp-config"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-mcp-client": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "0.0.1-rc.5",
    "@deepseek-ai/dsh-mcp-client": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage": "0.0.1-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.0.1-rc.5",
    "@deepseek-ai/dsh-storage-json": "0.0.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/react": "^19.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "react": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
